# Project runtime defaults for Starun.
# This file is versioned and loaded automatically by the GUI and direct pipeline runs.
# Outbound network is fail-closed; online catalog access requires this opt-in.
STARUN_NETWORK_MODE=0

STARUN_DEBUG_MODE=0
STARUN_INPUT_MODE=auto
STARUN_OUTPUT_FORMAT=all
STARUN_WORKFLOW_PLUGIN_PROBE=0
# Stage 2 所有自动裁切必须保留以原图中心为锚点的至少 70% 面积。
STARUN_STAGE2_CENTER_PROTECT_AREA_RATIO=0.70
# Stage 4 对确认线性的宽带/双窄带优先执行一次 SPCC；异常时宽带回退 PCC，双窄带 PCC 仅作需复核的降级基础校色。
STARUN_SPCC_ENABLE=1
STARUN_STAGE4_PLATESOLVE_ENABLE=1
STARUN_STAGE4_AUTO_GEOMETRY_ENABLE=1
STARUN_STAGE4_AUTO_GEOMETRY_CONFIDENCE_MIN=0.85
STARUN_STAGE4_AUTO_GEOMETRY_SCALE_RESIDUAL_MAX=0.05
STARUN_STAGE4_SPCC_TIMEOUT_SEC=300
STARUN_STAGE4_SPCC_ONLINE_UNVERIFIED_TIMEOUT_SEC=90
# 留空：从 FITS 设备画像自动选择；未知设备安全跳过 SPCC。
STARUN_STAGE4_SPCC_OSC_SENSOR=
STARUN_STAGE4_SPCC_OSC_FILTER=
STARUN_STAGE4_SPCC_WHITE_REF="Average Spiral Galaxy"
STARUN_STAGE4_SPCC_LIMITMAG=10.5
# 双窄带默认值由设备画像/PipelineConfig 提供；仅在需要人工覆盖时设置 NB_*。
# 仅在双窄带 Ha/OIII 映射达到置信门时生成隔离 HOO 艺术派生图；主链随后恢复已选择的 SPCC、降级 PCC 或保色父本。
STARUN_STAGE4_NBN_ENABLE=1
STARUN_STAGE4_NBN_MAPPING_CONFIDENCE_MIN=0.85
STARUN_STAGE4_NBN_STRENGTH=0.55
STARUN_STAGE4_NBN_GAIN_LIMIT=1.08
STARUN_STAGE4_NBN_LINE_RATIO_DRIFT_MAX=0.12
STARUN_STAGE4_PLATESOLVE_CATALOGS=gaia
STARUN_STAGE4_PLATESOLVE_ORDER=3
STARUN_STAGE4_FILTER_HINT=
STARUN_STAGE4_PCC_TIMEOUT_SEC=180
# Gaia 不可用时允许宽带线性图使用非物理自动局部参考继续；恒星集合伪白参考首发仅影子评估。
STARUN_STAGE4_OFFLINE_FALLBACK_MODE=auto_local_reference
STARUN_STAGE4_AUTO_REFERENCE_GLOBAL_WHITE_ENABLE=0
STARUN_STAGE4_AUTO_REFERENCE_BACKGROUND_SAMPLE_TARGET=40
STARUN_STAGE4_AUTO_REFERENCE_BACKGROUND_SAMPLE_MIN=16
STARUN_STAGE4_AUTO_REFERENCE_HOLDOUT_RATIO=0.25
STARUN_STAGE4_AUTO_REFERENCE_BACKGROUND_ERROR_MIN=0.01
STARUN_STAGE4_AUTO_REFERENCE_BACKGROUND_IMPROVEMENT_MIN=0.10
STARUN_STAGE4_AUTO_REFERENCE_STAR_MIN_OBJECTS=16
STARUN_STAGE4_AUTO_REFERENCE_STAR_RATIO_MAD_MAX=0.12
STARUN_STAGE4_AUTO_REFERENCE_STAR_SATURATION_RATIO_MAX=0.10
STARUN_STAGE4_AUTO_REFERENCE_GAIN_LIMIT=1.10
STARUN_STAGE4_AUTO_REFERENCE_STAR_IMPROVEMENT_MIN=0.10
STARUN_STAGE4_AUTO_REFERENCE_HIGHLIGHT_CLIP_GROWTH_MAX=0.002
STARUN_STAGE4_AUTO_REFERENCE_BLACK_CLIP_GROWTH_MAX=0.002
STARUN_STAGE4_AUTO_REFERENCE_GRADIENT_GROWTH_MAX=1.05
STARUN_STAGE4_AUTO_REFERENCE_TEXTURE_GROWTH_MAX=1.10
STARUN_STAGE4_AUTO_REFERENCE_TARGET_CHROMA_DRIFT_MAX=0.08
STARUN_STAGE4_LOCAL_STAR_WB_ENABLE=1
STARUN_STAGE4_LOCAL_STAR_WB_MIN_PIXELS=32
STARUN_STAGE4_LOCAL_STAR_WB_GAIN_LIMIT=1.20
STARUN_STAGE4_LOCAL_STAR_MASK_RADIUS=2
STARUN_STAGE4_LOCAL_STAR_MASK_COVERAGE_MAX=0.12
STARUN_ABERRATION_API_ENABLE=0
STARUN_ABERRATION_PROVIDER=
STARUN_OPTIONAL_COLOR_TRANSFORM=0
STARUN_STAGE8_DUALBAND_PALETTE_ENABLE=1
STARUN_STAGE8_DUALBAND_PALETTE_STRENGTH=0.85
STARUN_STAGE8_DUALBAND_PALETTE_LUMA_DRIFT_MAX=0.005
STARUN_STAGE8_DUALBAND_PALETTE_CLIP_GROWTH_MAX=0.002
STARUN_STAGE8_DUALBAND_PALETTE_QUALITY_WARNING_TOLERANCE=0.50
STARUN_DENOISE_ENABLE=0
# STARUN_DENOISE_FORCE=1
STARUN_STAGE5_MULTISCALE_DENOISE_ENABLE=1
STARUN_STAGE5_MULTISCALE_DENOISE_STRENGTH=0.72
STARUN_STAGE5_MULTISCALE_DETAIL_RETENTION_MIN=0.82
STARUN_STAGE5_MULTISCALE_NOISE_REDUCTION_MIN=0.05
STARUN_STAGE5_DENOISE_CHROMA_NOISE_GROWTH_MAX=1.05
STARUN_DENOISE_MOD=0.35
STARUN_STAGE5_DECONV_ENABLE=1
STARUN_STAGE5_GRAXPERT_DECONV_ENABLE=1
STARUN_STAGE5_RL_MAXSTARS=200
STARUN_STAGE5_RL_PSF_KS=33
STARUN_STAGE5_RL_ITERS=8
STARUN_STAGE5_RL_ALPHA=3000
STARUN_STAGE5_RL_GDSTEP=0.0005
STARUN_STAGE5_RL_STOP=0.001
STARUN_STAGE5_GRAXPERT_DECONV_STRENGTH=0.30
# 用户自行提供的 GraXpert 对象反卷积 model.onnx、语义版本目录或模型家族目录。
# 必须使用官方语义版本目录（例如 1.0.1）；留空时自动回退 Siril RL。
STARUN_GRAXPERT_OBJECT_MODEL_PATH=

STARUN_STAGE7_QUALITY_RETRY_MAX=2
STARUN_STAGE8_LOCAL_ADJUSTMENT_ENGINE_ENABLE=1
STARUN_STAGE8_LOCAL_CURVE_OPACITY=0.30
# Stage 9 直接调用随包 Seti Astro Suite Pro 的无头适配器；不依赖
# STARUN_WORKFLOW_PLUGIN_PROBE，因此不会尝试未注册的 Siril 命令。
STARUN_STAGE9_SASP_STAR_STRETCH_ENABLE=1
STARUN_STAGE9_SASP_STAR_STRETCH_AMOUNT=3.00
# 仅当 Stage 4 已冻结并确认 R→Ha、G/B→OIII 的双窄带映射时运行。
STARUN_STAGE9_NB_TO_RGB_STARS_ENABLE=1
STARUN_STAGE9_NB_TO_RGB_STARS_RATIO=0.30
STARUN_STAGE9_STARMASK_STRETCH_ENABLE=1
STARUN_STAGE9_STARMASK_ADAPTIVE_STRETCH_ENABLE=1
# 紧凑支持候选保持开启；拉伸前像素缩星默认关闭，可由任务专家参数开启。
STARUN_STAGE9_COMPACT_STARMASK_ENABLE=1
STARUN_STAGE9_STARMASK_PRE_STRETCH_COMPACT_ENABLE=0
STARUN_STAGE9_STAR_COLOR_REPAIR_ENABLE=1
STARUN_STAGE9_STAR_COLOR_REPAIR_STRENGTH=0.72
STARUN_STAGE9_STAR_COLOR_SUPPORT_RATIO_MAX=0.12
STARUN_STAGE9_STAR_COLOR_IMPROVEMENT_MIN=0.01
STARUN_STAGE9_STAR_COLOR_POST_CHROMA_ERROR_MAX=0.22
STARUN_STAGE9_SOURCE_STAR_DETAIL_PERCENTILE=98.0
STARUN_STAGE9_STARMASK_ASINH_STRETCH=2.00
STARUN_STAGE9_STARMASK_ASINH_OFFSET=0.001
STARUN_STAGE9_STARMASK_ASINH_STRETCH_MAX=1000.0
STARUN_STAGE9_STARMASK_FAINT_TARGET=0.26
STARUN_STAGE9_STARMASK_MID_TARGET=0.50
STARUN_STAGE9_STARMASK_BRIGHT_TARGET=0.75
STARUN_STAGE9_STARMASK_PEAK_TARGET=0.90
STARUN_STAGE9_STARMASK_CHROMA_REGULARIZATION_ENABLE=1
STARUN_STAGE9_STARMASK_FAINT_CHROMA_MAX=0.35
STARUN_STAGE9_STARMASK_BRIGHT_CHROMA_MAX=0.60
STARUN_STAGE9_STARMASK_PREDICTED_CHANGE_RATIO_MAX=0.30
STARUN_STAGE9_STAR_REFERENCE_SIGMA=5.0
STARUN_STAGE9_COMPACT_WEAK_STAR_RETENTION_MIN=0.80
STARUN_STAGE9_MIXED_STAR_PEAK_RATIO_MIN=4.0
STARUN_STAGE9_MIXED_STAR_WEAK_COUNT_MIN=20
STARUN_STAGE9_MIXED_STAR_BRIGHT_COUNT_MIN=3
STARUN_STAGE7_TARGET_LOCAL_METRICS_ENABLE=1
STARUN_STAGE7_LOCAL_CORE_CLIP_RATIO_MAX=0.12
STARUN_STAGE7_LOCAL_FAINT_SNR_MIN=0.25
STARUN_STAGE7_LOCAL_DARK_SEPARATION_MIN=0.001
STARUN_STAGE7_STRETCH_CHROMA_NOISE_SCORE_MAX=0.34
STARUN_STAGE7_STRETCH_BACKGROUND_MOTTLING_SCORE_MAX=0.45
STARUN_STAGE7_STRETCH_CHROMA_LOAD_GROWTH_MAX=1.35
STARUN_STAGE7_STRETCH_CHROMA_LOAD_LOW_ABSOLUTE_MAX=0.05
STARUN_STAGE7_STRETCH_CHROMA_LOAD_LOW_ABSOLUTE_TOLERANCE=0.0005
STARUN_STAGE7_UNCALIBRATED_BACKGROUND_CHROMA_LOAD_REVIEW_MAX=0.12
STARUN_STAGE7_PREVIEW_TARGET_P50_MIN_RATIO=0.55
STARUN_STAGE7_PREVIEW_TARGET_P50_MAX_RATIO=1.50
STARUN_STAGE7_STARLESS_PEAK_BACKGROUND_RATIO_MIN=4.0
STARUN_STAGE9_QUALITY_GATE_ENABLE=1
STARUN_STAGE9_HIGHLIGHT_CLIP_RATIO_MAX=0.015
STARUN_STAGE9_HIGHLIGHT_CLIP_GROWTH_MAX=0.006
STARUN_STAGE9_BRIGHT_PIXEL_GROWTH_MAX=0.025
STARUN_STAGE9_BACKGROUND_LIFT_MAX=0.010
STARUN_STAGE9_BACKGROUND_MOTTLING_GROWTH_MAX=1.35
STARUN_STAGE9_MOTTLING_EXEMPTION_CHANGED_PIXEL_RATIO_MAX=0.12
STARUN_STAGE9_CHANGED_PIXEL_RATIO_MAX=0.35
STARUN_STAGE9_DARKENING_RATIO_MAX=0.005
STARUN_STAGE9_WEAK_STAR_RECOVERY_RATIO_MIN=0.70
STARUN_STAGE9_STAR_RECOVERY_RATIO_MIN=0.75
STARUN_STAGE9_WEAK_STAR_SCREEN_INTENSITY_MIN=0.40
STARUN_STAGE9_STAR_SUPPORT_RATIO_MAX=0.12
STARUN_STAGE9_UNMATCHED_CHANGED_RATIO_MAX=0.01
STARUN_STAGE9_CHROMATIC_ADDITION_PEAK_MIN=0.02
STARUN_STAGE9_CHROMATIC_ADDITION_SATURATION_MIN=0.70
STARUN_STAGE9_CHROMATIC_ADDITION_RATIO_MAX=0.003
STARUN_STAGE9_LOCAL_COMPONENT_PEAK_MIN=0.01
STARUN_STAGE9_LOCAL_COMPONENT_AREA_MAX=256
STARUN_STAGE9_LOCAL_COMPONENT_ASPECT_RATIO_MAX=3.0
STARUN_STAGE9_LOCAL_COMPONENT_FILL_RATIO_MIN=0.15
STARUN_STAGE9_LOCAL_SINGLE_PIXEL_RATIO_MAX=0.20
STARUN_STAGE9_LOCAL_CYAN_BLUE_PEAK_MIN=0.01
STARUN_STAGE9_LOCAL_CYAN_BLUE_SATURATION_MIN=0.50
STARUN_STAGE9_LOCAL_CYAN_BLUE_COMPONENT_AREA_MAX=64
STARUN_STAGE9_CORE_PERCENTILE=90
STARUN_STAGE9_CORE_COLOR_JUMP_MIN=0.10
STARUN_STAGE9_CORE_COLOR_JUMP_COMPONENT_AREA_MAX=64
STARUN_STAGE9_STAR_POSITIVE_DELTA_WINDOW_RECOVERY_RATIO_MIN=0.75
STARUN_STAGE9_STAR_WING_RECOVERY_RATIO_MIN=0.65
STARUN_STAGE9_RESIDUAL_DARK_HOLE_RATIO_MAX=0.15
# 默认交付正式 result_processed/result_final；仅在质量门失败或显式设为 1 时输出 result_review*。
STARUN_FORCE_REVIEW_ONLY_OUTPUT=0
# 独立导出 *_display_srgb.png 与 *_edit_srgb.tif；不会改写 FITS。
STARUN_STAGE10_MANAGED_OUTPUT_ENABLE=1
STARUN_STAGE10_CHROMA_FOCUS_SCORE_MIN=0.34
STARUN_STAGE10_SEPARATE_CHROMA_SCORE_MIN=0.70
STARUN_STAGE10_FULL_BG_STD_MIN=0.018
STARUN_STAGE10_FULL_MOTTLING_SCORE_MIN=0.45
STARUN_STAGE10_FINAL_DENOISE_STRENGTH=0.28
STARUN_STAGE10_STAR_PROTECTION_COVERAGE_MAX=0.35
STARUN_STAGE10_LARGE_GALAXY_LOCAL_PATCH_VARIANCE_MAX=0.00032
STARUN_STAGE10_STAGE9_LOCAL_COLOR_RISK_STRENGTH=1.0
STARUN_STAGE7_BRIGHT_NEBULA_HALO_RESIDUE_SCORE_MAX=0.60
# 星系目标：在同一局部 Range-Stretch 下复核盘区 halo，并保护亮核/盘面真实结构。
STARUN_STAGE7_GALAXY_ROI_HALO_GATE_ENABLE=1
STARUN_STAGE7_GALAXY_CORE_PRESERVATION_RATIO_MIN=0.72
STARUN_STAGE7_GALAXY_CORE_CONTRAST_RATIO_MIN=0.60
STARUN_STAGE7_STARLESS_REPAIR_STRENGTH=0.68
STARUN_STAGE7_STARLESS_HALO_REPAIR_STRENGTH=0.70
STARUN_STAGE7_STARLESS_CHROMA_DENOISE_STRENGTH=0.55
STARUN_STAGE7_STARLESS_REPAIR_CHROMA_REDUCTION_MIN=0.20
STARUN_STAGE7_STARLESS_REPAIR_CHROMA_DELTA_MIN=0.0005
STARUN_STAGE7_STARMASK_DIFFUSE_RESIDUAL_RATIO_MAX=0.08
STARUN_STAGE7_STARLESS_PIXEL_REPAIR_ENABLE=1
# Stage 6 修复验收或亮星云 halo 位于 0.35–0.60 时，Stage 8 生成受限候选而非直接跳过。
STARUN_STAGE8_FORCE_CONSERVATIVE_AFTER_STAGE7_REPAIR=1
STARUN_STAGE8_LIMITED_SATURATION_MAX=0.05
STARUN_STAGE8_LIMITED_HALO_TEXTURE_GROWTH_MAX=1.05
STARUN_STAGE8_LIMITED_HALO_TEXTURE_DELTA_MAX=0.00075

STARUN_COSMIC_CLASSIC_ENABLE=1
STARUN_COSMIC_CLARITY_EXECUTABLE=
STARUN_COSMIC_CLASSIC_GPU=1
STARUN_COSMIC_NATIVE_GPU=1
STARUN_SYQON_TIMEOUT_SEC=900
STARUN_BOOTSTRAP_TIMEOUT_SEC=300
STARUN_WATCHDOG_IDLE_TIMEOUT_SEC=900
STARUN_EXPORT_TAIL_TIMEOUT_SEC=120
STARUN_TEMP_CLEANUP_TIMEOUT_SEC=30
STARUN_SIRILPY_TIMEOUT_SEC=300
