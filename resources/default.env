SEESTAR_STAGE7_STARLESS_PIXEL_REPAIR_ENABLE=1
SEESTAR_STAGE8_FORCE_CONSERVATIVE_AFTER_STAGE7_REPAIR=1

SEESTAR_COSMIC_CLASSIC_ENABLE=1
SEESTAR_COSMIC_CLARITY_EXECUTABLE=
SEESTAR_COSMIC_CLASSIC_GPU=1
SEESTAR_COSMIC_NATIVE_GPU=1
