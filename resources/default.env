SEESTAR_STAGE9_QUALITY_GATE_ENABLE=1
SEESTAR_STAGE9_HIGHLIGHT_CLIP_RATIO_MAX=0.015
SEESTAR_STAGE9_HIGHLIGHT_CLIP_GROWTH_MAX=0.006
SEESTAR_STAGE9_BRIGHT_PIXEL_GROWTH_MAX=0.025
