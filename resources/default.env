# Project runtime defaults for SeestarSuperimpose.
# This file is versioned and loaded automatically by the GUI and direct pipeline runs.
# Developer release credentials come from a mode-0600 resources/ai.env at build
# time and are imported into macOS Keychain. End-user keys are configured in-app.

SEESTAR_AI_ENABLED=0
SEESTAR_AI_ENDPOINT=
SEESTAR_AI_MODEL=
SEESTAR_AI_API_KEY=
SEESTAR_AI_TIMEOUT_SEC=90
SEESTAR_AI_STRENGTH=0.12
SEESTAR_AI_ADVISOR_MODE=text
SEESTAR_AI_STAGE6_ENABLE=1
SEESTAR_AI_STAGE7_ENABLE=1
SEESTAR_AI_STAGE8_ENABLE=1
SEESTAR_AI_PROMPT=
SEESTAR_AI_ARTISTIC_DERIVATIVE_ENABLED=0
SEESTAR_AI_ARTISTIC_ENDPOINT=
SEESTAR_AI_ARTISTIC_MODEL=
SEESTAR_AI_ARTISTIC_API_KEY=
SEESTAR_AI_ARTISTIC_PROMPT=
SEESTAR_AI_ARTISTIC_TIMEOUT_SEC=180

SEESTAR_DEBUG_MODE=0
SEESTAR_INPUT_MODE=auto
SEESTAR_OUTPUT_FORMAT=all
SEESTAR_WORKFLOW_PLUGIN_PROBE=0
# Stage 4 仅对确认线性的宽带 RGB/OSC 执行一次在线 Gaia PCC。
SEESTAR_STAGE4_PLATESOLVE_ENABLE=1
SEESTAR_STAGE4_PLATESOLVE_CATALOGS=gaia
SEESTAR_STAGE4_PLATESOLVE_ORDER=3
SEESTAR_STAGE4_FILTER_HINT=
SEESTAR_STAGE4_PCC_TIMEOUT_SEC=30
SEESTAR_STAGE4_LOCAL_STAR_WB_ENABLE=1
SEESTAR_STAGE4_LOCAL_STAR_WB_MIN_PIXELS=32
SEESTAR_STAGE4_LOCAL_STAR_WB_GAIN_LIMIT=1.20
SEESTAR_STAGE4_LOCAL_STAR_MASK_RADIUS=2
SEESTAR_STAGE4_LOCAL_STAR_MASK_COVERAGE_MAX=0.12
SEESTAR_ABERRATION_API_ENABLE=0
SEESTAR_ABERRATION_PROVIDER=
SEESTAR_OPTIONAL_COLOR_TRANSFORM=0
SEESTAR_DENOISE_ENABLE=0
# SEESTAR_DENOISE_FORCE=1
SEESTAR_STAGE5_BUILTIN_DENOISE_MOD=0.50
SEESTAR_STAGE5_DECONV_ENABLE=1
SEESTAR_STAGE5_GRAXPERT_DECONV_ENABLE=1
SEESTAR_STAGE5_RL_MAXSTARS=200
SEESTAR_STAGE5_RL_PSF_KS=33
SEESTAR_STAGE5_RL_ITERS=8
SEESTAR_STAGE5_RL_ALPHA=3000
SEESTAR_STAGE5_RL_GDSTEP=0.0005
SEESTAR_STAGE5_RL_STOP=0.001
SEESTAR_STAGE5_GRAXPERT_DECONV_STRENGTH=0.30
# 用户自行提供的 GraXpert 对象反卷积 model.onnx、语义版本目录或模型家族目录。
# 必须使用官方语义版本目录（例如 1.0.1）；留空时自动回退 Siril RL。
SEESTAR_GRAXPERT_OBJECT_MODEL_PATH=

SEESTAR_STAGE7_QUALITY_RETRY_MAX=2
SEESTAR_STAGE9_STARMASK_STRETCH_ENABLE=1
SEESTAR_STAGE9_STARMASK_ADAPTIVE_STRETCH_ENABLE=1
SEESTAR_STAGE9_COMPACT_STARMASK_ENABLE=1
SEESTAR_STAGE9_SOURCE_STAR_DETAIL_PERCENTILE=98.0
SEESTAR_STAGE9_STARMASK_ASINH_STRETCH=2.00
SEESTAR_STAGE9_STARMASK_ASINH_OFFSET=0.001
SEESTAR_STAGE9_STARMASK_ASINH_STRETCH_MAX=1000.0
SEESTAR_STAGE9_STARMASK_FAINT_TARGET=0.26
SEESTAR_STAGE9_STARMASK_MID_TARGET=0.50
SEESTAR_STAGE9_STARMASK_BRIGHT_TARGET=0.75
SEESTAR_STAGE9_STARMASK_PEAK_TARGET=0.90
