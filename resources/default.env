# Project runtime defaults for SeestarSuperimpose.
# This file is versioned and loaded automatically by the GUI and direct pipeline runs.
# Put secrets or machine-local overrides in resources/ai.env or .seestar_ai.env.

SEESTAR_AI_ENABLED=0
SEESTAR_AI_ENDPOINT=
SEESTAR_AI_MODEL=
SEESTAR_AI_API_KEY=
SEESTAR_AI_TIMEOUT_SEC=90
SEESTAR_AI_STRENGTH=0.12
SEESTAR_AI_STAGE6_ENABLE=1
SEESTAR_AI_STAGE7_ENABLE=1
SEESTAR_AI_STAGE8_ENABLE=1
SEESTAR_AI_PROMPT=

SEESTAR_DEBUG_MODE=0
SEESTAR_INPUT_MODE=auto
SEESTAR_OUTPUT_FORMAT=all
SEESTAR_WORKFLOW_PLUGIN_PROBE=0
SEESTAR_SPCC_ENABLE=1
SEESTAR_STAGE4_PLATESOLVE_ENABLE=1
SEESTAR_STAGE4_PLATESOLVE_CATALOGS=gaia
SEESTAR_STAGE4_PLATESOLVE_ORDER=3
SEESTAR_STAGE4_SPCC_SENSOR_MODE=osc
SEESTAR_STAGE4_SPCC_OSC_SENSOR="Sony IMX585"
SEESTAR_STAGE4_SPCC_OSC_FILTER=
SEESTAR_STAGE4_SPCC_BUILTIN_DUALBAND_FILTER=0
SEESTAR_STAGE4_SPCC_WHITE_REF="Average Spiral Galaxy"
SEESTAR_STAGE4_SPCC_ADAPTIVE_WHITE_REF=0
SEESTAR_STAGE4_SPCC_NEBULA_WHITE_REF="Star, type G2(v)"
SEESTAR_STAGE4_SPCC_BGTOL="-2.8,2.0"
SEESTAR_STAGE4_SPCC_LIMITMAG=10.5
SEESTAR_STAGE4_SPCC_RESTORE_CPU=0
SEESTAR_STAGE4_PCC_CATALOGS=localgaia,gaia,nomad,apass
SEESTAR_STAGE4_PCC_HEADER_FALLBACK_ENABLE=1
SEESTAR_STAGE4_LOCAL_STAR_WB_ENABLE=1
SEESTAR_STAGE4_LOCAL_STAR_WB_MIN_PIXELS=32
SEESTAR_STAGE4_LOCAL_STAR_WB_GAIN_LIMIT=1.25
SEESTAR_STAGE4_LOCAL_STAR_WB_TARGET_AWARE_ENABLE=0
SEESTAR_SPCC_ALLOW_LIGHT_PREPROCESS=1
SEESTAR_ABERRATION_API_ENABLE=0
SEESTAR_ABERRATION_PROVIDER=
SEESTAR_OPTIONAL_COLOR_TRANSFORM=0
SEESTAR_DENOISE_ENABLE=0
# SEESTAR_DENOISE_FORCE=1
SEESTAR_STAGE5_BUILTIN_DENOISE_MOD=0.50
SEESTAR_STAGE5_DECONV_ENABLE=1
SEESTAR_STAGE5_RL_MAXSTARS=200
SEESTAR_STAGE5_RL_PSF_KS=33
SEESTAR_STAGE5_RL_ITERS=8
SEESTAR_STAGE5_RL_ALPHA=3000
SEESTAR_STAGE5_RL_GDSTEP=0.0005
SEESTAR_STAGE5_RL_STOP=0.001
SEESTAR_STAGE5_GRAXPERT_DECONV_STRENGTH=0.30

SEESTAR_STAGE7_QUALITY_RETRY_MAX=2
SEESTAR_STAGE9_STARMASK_STRETCH_ENABLE=1
SEESTAR_STAGE9_STARMASK_ASINH_STRETCH=2.00
SEESTAR_STAGE9_STARMASK_ASINH_OFFSET=0.001
SEESTAR_STAGE7_SKIP_UNREADY_STARLESS=1
SEESTAR_STAR_SEPARATION_MODE=linear_star_separation
SEESTAR_STAR_SEPARATION_FALLBACK_TO_MILD_PRESTRETCH=1
SEESTAR_MILD_PRESTRETCH_STRENGTH=1.35
SEESTAR_STAGE7_SOFT_STARLESS_ASINH_STRETCH=1.35
SEESTAR_STAGE7_BRIGHT_NEBULA_HALO_RESIDUE_SCORE_MAX=0.60
SEESTAR_STAGE7_STARLESS_REPAIR_STRENGTH=0.68
SEESTAR_STAGE7_STARLESS_HALO_REPAIR_STRENGTH=0.70
SEESTAR_STAGE7_STARLESS_CHROMA_DENOISE_STRENGTH=0.55
SEESTAR_STAGE7_STARLESS_PIXEL_REPAIR_ENABLE=1
SEESTAR_STAGE8_FORCE_CONSERVATIVE_AFTER_STAGE7_REPAIR=1

SEESTAR_COSMIC_CLASSIC_ENABLE=1
SEESTAR_COSMIC_CLARITY_EXECUTABLE=
SEESTAR_COSMIC_CLASSIC_GPU=1
SEESTAR_COSMIC_NATIVE_GPU=1
SEESTAR_SYQON_GPU=1
SEESTAR_SYQON_TIMEOUT_SEC=900
SEESTAR_SIRILPY_TIMEOUT_SEC=120
