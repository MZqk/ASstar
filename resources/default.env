SEESTAR_STAGE9_MOTTLING_EXEMPTION_CHANGED_PIXEL_RATIO_MAX=0.12
SEESTAR_STAGE9_CHANGED_PIXEL_RATIO_MAX=0.35
SEESTAR_STAGE9_DARKENING_RATIO_MAX=0.005
SEESTAR_STAGE9_WEAK_STAR_RECOVERY_RATIO_MIN=0.70
SEESTAR_STAGE9_STAR_RECOVERY_RATIO_MIN=0.75
SEESTAR_STAGE9_WEAK_STAR_SCREEN_INTENSITY_MIN=0.40
SEESTAR_STAGE9_STAR_SUPPORT_RATIO_MAX=0.12
SEESTAR_STAGE9_UNMATCHED_CHANGED_RATIO_MAX=0.01
SEESTAR_STAGE9_CHROMATIC_ADDITION_PEAK_MIN=0.02
SEESTAR_STAGE9_CHROMATIC_ADDITION_SATURATION_MIN=0.70
SEESTAR_STAGE9_CHROMATIC_ADDITION_RATIO_MAX=0.003
SEESTAR_STAGE9_LOCAL_COMPONENT_PEAK_MIN=0.01
SEESTAR_STAGE9_LOCAL_COMPONENT_AREA_MAX=256
SEESTAR_STAGE9_LOCAL_COMPONENT_ASPECT_RATIO_MAX=3.0
SEESTAR_STAGE9_LOCAL_COMPONENT_FILL_RATIO_MIN=0.15
SEESTAR_STAGE9_LOCAL_SINGLE_PIXEL_RATIO_MAX=0.20
SEESTAR_STAGE9_LOCAL_CYAN_BLUE_PEAK_MIN=0.01
SEESTAR_STAGE9_LOCAL_CYAN_BLUE_SATURATION_MIN=0.50
SEESTAR_STAGE9_LOCAL_CYAN_BLUE_COMPONENT_AREA_MAX=64
SEESTAR_STAGE9_CORE_PERCENTILE=90
SEESTAR_STAGE9_CORE_COLOR_JUMP_MIN=0.10
SEESTAR_STAGE9_CORE_COLOR_JUMP_COMPONENT_AREA_MAX=64
SEESTAR_STAGE9_STAR_APERTURE_RECOVERY_RATIO_MIN=0.75
SEESTAR_STAGE9_STAR_WING_RECOVERY_RATIO_MIN=0.65
