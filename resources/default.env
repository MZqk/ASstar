# 默认交付正式 result_processed/result_final；仅在质量门失败或显式设为 1 时输出 result_review*。
SEESTAR_FORCE_REVIEW_ONLY_OUTPUT=0
SEESTAR_STAGE10_CHROMA_FOCUS_SCORE_MIN=0.34
SEESTAR_STAGE10_SEPARATE_CHROMA_SCORE_MIN=0.70
