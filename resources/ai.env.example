# Developer trial configuration example for SeestarSuperimpose.
# Copy to resources/ai.env and set mode 0600 before building. The release build
# keeps endpoint/model in a sanitized ai.env and converts non-empty API keys to
# an obfuscated first-run payload that is imported into macOS Keychain.
# Supported format:
#   KEY=value
#   export KEY=value

# Required in addition to AI/artistic switches for any outbound request.
SEESTAR_NETWORK_MODE=1
SEESTAR_AI_ENABLED=1
SEESTAR_AI_ENDPOINT="https://api.moonshot.cn/v1/chat/completions"
SEESTAR_AI_MODEL="kimi-k2.5"
SEESTAR_AI_API_KEY="<replace-with-your-key>"
SEESTAR_AI_TIMEOUT_SEC=90
SEESTAR_AI_STRENGTH=0.12
SEESTAR_AI_ADVISOR_MODE=text
SEESTAR_AI_STAGE6_ENABLE=1
SEESTAR_AI_STAGE7_ENABLE=1
SEESTAR_AI_STAGE8_ENABLE=1
# SEESTAR_AI_PROMPT=""

# Completely isolated artistic derivative experiment. It does not reuse the
# advisor endpoint/model/key and never feeds its output back into Siril.
# SEESTAR_AI_ARTISTIC_DERIVATIVE_ENABLED=1
# SEESTAR_AI_ARTISTIC_ENDPOINT="https://api.example.com/v1/images/edits"
# SEESTAR_AI_ARTISTIC_MODEL="<image-edit-model>"
# SEESTAR_AI_ARTISTIC_API_KEY="<replace-with-separate-key>"
# SEESTAR_AI_ARTISTIC_PROMPT="Create a tasteful artistic derivative..."
# SEESTAR_AI_ARTISTIC_TIMEOUT_SEC=180

# End users should configure their own endpoint/model/key through “模型配置…”.
# Runtime .seestar_ai.env files no longer supply API key fields to the GUI worker.

# Non-secret runtime knobs are already defined in resources/default.env.
# Override only when needed:
# SEESTAR_WORKFLOW_PLUGIN_PROBE=1
# External star-separation pre-stretch controls are retired and ignored.
# SEESTAR_OUTPUT_FORMAT=tif,png,fit
# SEESTAR_WATCHDOG_IDLE_TIMEOUT_SEC=900
# SEESTAR_EXPORT_TAIL_TIMEOUT_SEC=120
# SEESTAR_STAGE4_PLATESOLVE_ENABLE=1
# SEESTAR_STAGE4_PLATESOLVE_CATALOGS=gaia
# SEESTAR_STAGE4_PLATESOLVE_ORDER=3
# SEESTAR_STAGE4_PLATESOLVE_HEADER_RADIUS=
# SEESTAR_STAGE4_SPCC_BUILTIN_DUALBAND_FILTER=0
# SEESTAR_STAGE4_SPCC_OSC_FILTER=
# SEESTAR_STAGE4_SPCC_ADAPTIVE_WHITE_REF=0
# SEESTAR_STAGE4_SPCC_NEBULA_WHITE_REF="Star, type G2(v)"
# SEESTAR_STAGE4_SPCC_LIMITMAG=10.5
# SEESTAR_STAGE4_SPCC_RESTORE_CPU=0
# SEESTAR_STAGE4_PCC_CATALOGS=localgaia,gaia,nomad,apass
# SEESTAR_STAGE4_PCC_HEADER_FALLBACK_ENABLE=1
# SEESTAR_STAGE4_LOCAL_STAR_WB_ENABLE=1
# SEESTAR_STAGE4_LOCAL_STAR_WB_MIN_PIXELS=32
# SEESTAR_STAGE4_LOCAL_STAR_WB_GAIN_LIMIT=1.25
# SEESTAR_STAGE4_LOCAL_STAR_WB_TARGET_AWARE_ENABLE=0
# SEESTAR_SPCC_ALLOW_LIGHT_PREPROCESS=1
# SEESTAR_STAGE5_BUILTIN_DENOISE_MOD=0.50
# SEESTAR_STAGE5_DECONV_ENABLE=1
# SEESTAR_STAGE5_RL_ITERS=8
# SEESTAR_STAGE5_GRAXPERT_DECONV_STRENGTH=0.30
# SEESTAR_GRAXPERT_OBJECT_MODEL_PATH="/Users/example/Library/Application Support/GraXpert/deconvolution-object-ai-models/1.0.1"
# SEESTAR_STAGE9_STARMASK_STRETCH_ENABLE=1
# SEESTAR_STAGE9_STARMASK_ADAPTIVE_STRETCH_ENABLE=1
# SEESTAR_STAGE9_COMPACT_STARMASK_ENABLE=1
# SEESTAR_STAGE9_STARMASK_ASINH_STRETCH=2.00
