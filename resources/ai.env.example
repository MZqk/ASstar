# Optional AI config for SeestarSuperimpose GUI/Finder launch.
# Enables stage 6-8 AI parameter optimization/diagnostics and optional stage 11 AI copies.
# Supported format:
#   KEY=value
#   export KEY=value

SEESTAR_AI_ENABLED=true
SEESTAR_AI_ENDPOINT="https://api.moonshot.cn"
SEESTAR_AI_MODEL="kimi-k2.5"
SEESTAR_AI_API_KEY="<replace-with-your-key>"
SEESTAR_AI_TIMEOUT_SEC=90
SEESTAR_AI_STRENGTH=0.12
# SEESTAR_AI_STAGE6_ENABLE=true
# SEESTAR_AI_STAGE7_ENABLE=true
# SEESTAR_AI_STAGE8_ENABLE=true
# SEESTAR_STAGE7_QUALITY_RETRY_MAX=2
# SEESTAR_AI_PROMPT=""
